# Copy to `.env` (git ignores it) and fill in what your shell does not already export.
# A variable in the environment wins over this file. Never commit a key.

# Asset generation (docs/assets.md)
OPENROUTER_API_KEY=
PIXELLAB_TOKEN=
ELEVENLABS_TOKEN=

# iOS device and release builds: the Apple developer team id (docs/mobile.md)
IOS_TEAM=

# Android release bundle: the upload keystore and its password (docs/mobile.md)
ANDROID_UPLOAD_KEYSTORE=
ANDROID_UPLOAD_PASSWORD=
