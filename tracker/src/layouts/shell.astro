---
import { getEntry } from 'astro:content';
import '../styles/app.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { dir } = (await getEntry('index', 'index'))!.data;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap top">
      <a href="/">Issue board</a>
      <span class="muted">Read-only view of <code>{dir}/</code></span>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding-bottom: 0;
  }

  .top a {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
</style>
