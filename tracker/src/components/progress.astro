---
/* A bar. The page shows the numbers as text next to it. */
interface Props {
  value: number;
  total: number;
  label: string;
}

const { value, total, label } = Astro.props;
const percent = total === 0 ? 0 : (value / total) * 100;
---

<div class="progress" role="img" aria-label={label}>
  <i style={`width:${percent}%`}></i>
</div>

<style>
  .progress {
    height: 8px;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }

  i {
    display: block;
    height: 100%;
    background: var(--done);
  }
</style>
